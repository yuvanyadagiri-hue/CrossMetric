# Optional. When set, CrossMetric reads from Supabase PostgreSQL + PostGIS instead of
# data/published. Copy the connection string from Supabase: Project Settings -> Database.
# Put the real value in apps/web/.env.local (git-ignored), never in this file.
DATABASE_URL=

# Optional. Directory holding the pipeline's published files (default: ../../data/published).
CROSSMETRIC_DATA_DIR=

# Optional. Routing (Valhalla) and place search (Photon) services. Defaults are the free public
# OpenStreetMap services (fair use); point these at self-hosted servers for heavier use.
VALHALLA_URL=
GEOCODER_URL=

# Optional. Where community reports are stored when DATABASE_URL is not set (default: ../../data/community).
COMMUNITY_DATA_DIR=

# Required for "Continue in Uber". The public Client ID of your app from the Uber developer
# dashboard (developer.uber.com -> Dashboard -> your app). It identifies CrossMetric in Uber's
# ride-request universal link (https://m.uber.com/looking?client_id=...). It is public — it
# appears in every link — so NEXT_PUBLIC_ is correct. Never put a client secret or server token
# here: the handoff is link-only and needs no Uber OAuth or Riders API access.
# Restart `next dev` / rebuild after changing it (NEXT_PUBLIC_ values are inlined at build time).
NEXT_PUBLIC_UBER_CLIENT_ID=

# Commuter app (Georgia Tech / UGA). All optional.
# 0 restores the previous dashboard at "/" (read per request).
CROSSMETRIC_COMMUTER_HOME=
# National Weather Service asks for an identifying User-Agent with a contact (URL or email).
NWS_USER_AGENT=
# Salt for hashing anonymous parking-report device keys (keeps rate limits and undo across restarts).
OBSERVATION_SALT=
# Internal research workspace (/internal/research): set a random token of 16+ characters to enable it.
CROSSMETRIC_INTERNAL_TOKEN=
# 0 switches the research pipeline off.
RESEARCH_PIPELINE_ENABLED=
