{
  "name": "@crossmetric/engine",
  "version": "1.0.0",
  "private": true,
  "description": "CrossMetric scoring engine: normalization, Priority for Review, sensitivity, explanations and Resource Planner. Pure TypeScript, no runtime dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./commute": "./src/commute/index.ts",
    "./research": "./src/research/index.ts",
    "./model.json": "./model/crossmetric-model.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^5.0.3",
    "@types/node": "^24"
  }
}
